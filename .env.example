# Copy to .env.local and fill in values only when you configure each service.
# Every value here is intentionally blank. Never commit .env.local.
# Keep secrets server-side. Never put a secret in a NEXT_PUBLIC_* variable.
# Full descriptions: architectural-ai-design-spec/ENVIRONMENT_VARIABLES.md
#
# Phase 1 needs none of these. The app runs with all of them blank. Each service
# is first used in the phase noted next to it, and its names are confirmed
# against the real provider before use.

# Application
# PROVIDER_MODE: "mock" or "live". Unset behaves as "mock". Not read by Phase 1.
PROVIDER_MODE=
NEXT_PUBLIC_APP_URL=
APP_BASE_URL=
ADMIN_EMAILS=

# Supabase (Phase 2). Service role key and DB URL are server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=

# OpenRouter (Phase 5 text, Phase 6 image). Server-only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_TEXT_MODEL=
OPENROUTER_IMAGE_MODEL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# Gnani speech-to-text / text-to-speech (Phase 5). Server-only; confirm the real API first.
GNANI_API_KEY=
GNANI_BASE_URL=
GNANI_STT_ENDPOINT=
GNANI_TTS_ENDPOINT=
GNANI_STT_MODEL=
GNANI_TTS_MODEL=
GNANI_TTS_VOICE=

# Manual payment instructions, display only (Phase 4)
PAYMENT_MODE=
PAYMENT_UPI_ID=
PAYMENT_ACCOUNT_NAME=
PAYMENT_INSTRUCTIONS=
PAYMENT_CURRENCY=

# Optional operational services
LOG_LEVEL=
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=
