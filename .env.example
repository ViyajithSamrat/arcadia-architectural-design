# Copy to .env.local and fill in values only when you configure each service.
# Every value here is intentionally blank. Never commit .env.local.
# Keep secrets server-side. Never put a secret in a NEXT_PUBLIC_* variable.
# Full descriptions: docs/ENVIRONMENT.md
#
# The app runs with all of these blank: a feature whose settings are missing reports itself
# as unavailable instead of pretending to work.

# Application
# PROVIDER_MODE: "mock" or "live". Unset behaves as "mock" (clearly labelled placeholders).
PROVIDER_MODE=
# The exact public origin, for example https://example.vercel.app. Set it in every deployment.
NEXT_PUBLIC_APP_URL=
# Reserved: validated but not read by the application (see docs/ENVIRONMENT.md).
APP_BASE_URL=
ADMIN_EMAILS=

# Supabase. The secret key, the service role key and the DB URL are server-only.
# Hosted projects: use the publishable and secret keys. The legacy anon and service role
# keys are fallbacks (the local Docker stack prints those); the modern name wins when both are set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=

# OpenRouter (text and images). Server-only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_TEXT_MODEL=
# TRANSLATION_MODE: empty or "off" = no automatic translation (the customer types the English
# version of a non-English transcript); "live" = translate with OPENROUTER_TEXT_MODEL, independent of
# PROVIDER_MODE. Each translation is one OpenRouter text request, metered against
# AI_TRANSLATIONS_PER_HOUR (its own per-customer allowance) and OPENROUTER_DAILY_REQUEST_CAP. Incomplete settings show "unavailable", never a mock translation.
TRANSLATION_MODE=
# OPENROUTER_TEXT_REASONING_EFFORT: "none", "minimal" or "low" (OpenRouter reasoning.effort) for the
# brief and translation. Empty = not sent (the model default). "none" turns thinking off on models that
# allow it, so no thinking tokens are billed or eat into the JSON answer. Any other value disables them.
OPENROUTER_TEXT_REASONING_EFFORT=
OPENROUTER_IMAGE_MODEL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# Image generation. With PROVIDER_MODE unset or "mock" a labelled MOCK placeholder is used. With
# PROVIDER_MODE=live the OpenRouter Image API is used, and only when OPENROUTER_API_KEY and
# OPENROUTER_IMAGE_MODEL (author/slug) are set; otherwise generation reports itself unavailable
# (never the mock). The settings below are optional and have safe defaults.
# OPENROUTER_IMAGE_RESOLUTION (1K default, 2K, 4K; bytedance-seed/seedream-4.5 needs 2K: it refuses fewer than
# 3,686,400 output pixels), OPENROUTER_IMAGE_ASPECT_RATIO (16:9 default),
# OPENROUTER_IMAGE_FORMAT (jpeg default, png, webp: stored files must stay within 5 MiB),
# OPENROUTER_IMAGE_TIMEOUT_MS (per image, 90000 default, 10000 to 180000),
# OPENROUTER_IMAGE_REFERENCES (true = send up to three customer reference photos to the image
# service; anything else = never send them).
# Image generation has no ARCADIA quota: OPENROUTER_IMAGES_PER_HOUR and OPENROUTER_IMAGES_PER_DAY are no
# longer read (the provider's own account balance is the limit); every image request is still recorded.
OPENROUTER_IMAGE_RESOLUTION=
OPENROUTER_IMAGE_ASPECT_RATIO=
OPENROUTER_IMAGE_FORMAT=
OPENROUTER_IMAGE_TIMEOUT_MS=
OPENROUTER_IMAGE_REFERENCES=
# Images per generation request (1 to 4, default 2). It can only lower the built-in ceiling, and
# the views each project type needs limit it further (currently 1 or 2).
MAX_GENERATION_IMAGES=
# Finished, real (non-placeholder) concepts reach the customer automatically. Set to false to
# require an administrator to release them. Placeholder output always needs an administrator.
GENERATION_AUTO_RELEASE=

# Gnani speech-to-text / text-to-speech. Server-only. Confirm the values against your Gnani account.
# Documented 2026-10-22 (docs.gnani.ai): base https://api.vachana.ai, STT path /stt/v3, TTS path /api/v1/tts/inference,
# TTS models timbre-v2.5 or timbre-v3.0 (a voice must belong to the model; see the Gnani voice catalog).
# On Git Bash, set MSYS_NO_PATHCONV=1 when passing path values through environment variables.
GNANI_API_KEY=
GNANI_BASE_URL=
GNANI_STT_ENDPOINT=
GNANI_TTS_ENDPOINT=
GNANI_STT_MODEL=
GNANI_TTS_MODEL=
GNANI_TTS_VOICE=
# GNANI_VOICE_ENABLED: empty = voice off (default); "mock" = labelled MOCK transcriber, no
# network and no credits; "true" = live speech-to-text only when every STT value below is set,
# otherwise unavailable (never the mock). See docs/PROVIDERS.md for what has been verified.
# Spoken read-back (text-to-speech) also needs
# GNANI_VOICE_ENABLED=true and every TTS value below, including en-IN in GNANI_LANGUAGES (fail closed).
# GNANI_BUDGET_CREDITS can never exceed 5000 (the owner's hard ceiling), whatever is set here.
# Credits-per-unit figures come from your Gnani account: Gnani's documentation gives none.
GNANI_VOICE_ENABLED=
GNANI_LANGUAGES=
GNANI_STT_MAX_SECONDS=
GNANI_TTS_MAX_CHARS=
GNANI_CREDITS_PER_STT_SECOND=
GNANI_CREDITS_PER_TTS_CHAR=
GNANI_MAX_CREDITS_PER_REQUEST=
GNANI_CUSTOMER_CREDITS_PER_HOUR=
GNANI_BUDGET_CREDITS=
# VOICE_TRANSCRIPT_SECRET: server-only random string of at least 32 characters that signs voice
# transcripts, so a saved description can be told apart from typed text. Required for live
# speech-to-text. Never use a NEXT_PUBLIC_ name for it. Without it, mock mode uses a key held by
# the running server process only.
VOICE_TRANSCRIPT_SECRET=

# AI request limits
PROVIDER_TIMEOUT_MS=
AI_BRIEFS_PER_HOUR=
AI_TRANSLATIONS_PER_HOUR=
OPENROUTER_DAILY_REQUEST_CAP=

# Manual payment instructions, display only. Nothing here moves money.
PAYMENT_MODE=
PAYMENT_UPI_ID=
PAYMENT_ACCOUNT_NAME=
PAYMENT_INSTRUCTIONS=
PAYMENT_CURRENCY=
# PAYMENT_MOCK_GATEWAY: "true" adds a SIMULATED checkout (success / failure / cancel) on the payment
# page. No money moves and no payment details are collected. A simulated success only records a
# PENDING claim with a MOCKPAY- reference; an administrator must still verify it. Needs the manual
# PAYMENT_* values above. Leave empty in any real deployment.
PAYMENT_MOCK_GATEWAY=

# Reserved: validated but not read by the application (see docs/ENVIRONMENT.md).
LOG_LEVEL=
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=
